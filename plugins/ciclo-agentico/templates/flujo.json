{
  "$comentario": "Valores de EJEMPLO: /ciclo-init los sustituye por los del proyecto. Las claves que empiezan por $ se ignoran. La clave test de verificacion solo debe existir si el proyecto tiene una base de tests real: el developer aplica TDD solo cuando existe.",
  "guias": ["docs/guias/normas.md"],
  "integracion": ["docs/integracion/contrato-cliente.md"],
  "skillsProyecto": ["plugins/mi-dominio/skills"],
  "marketplaceLocal": "plugins",
