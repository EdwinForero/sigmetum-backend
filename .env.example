NODE_ENV=local
PORT=8000

# AWS — config (cambia por entorno)
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=sigmetum-dev

# AWS — credenciales
# En local: autenticación vía SSO profile (no usar ACCESS_KEY ni SECRET)
AWS_PROFILE=my-sso-profile
# En preprod/prod: dejar AWS_PROFILE vacío — el SDK usa el IAM role del servidor automáticamente

# Auth (Cognito)
# COGNITO_USER_POOL_ID: id del pool de usuarios, con la forma <región>_<id> y la región igual a AWS_REGION.
# Obligatoria en todo entorno, también local y test: con otro formato o región el backend no arranca.
COGNITO_USER_POOL_ID=

# Email
EMAIL=
EMAIL_PASSWORD=

# CORS — URL del frontend (cambia por entorno)
ALLOWED_ORIGIN=http://localhost:3000

# API prefix
API_PREFIX=/api/v1

# Saltos de proxy de confianza (trust proxy): cuántos proxies entre el cliente y Express añaden su dirección a X-Forwarded-For.
# Valores admitidos: entero de 1 a 5 (0 solo con NODE_ENV=local o test); vacía no es válida. Sin definir vale 1.
# Los saltos reales los fija infra por entorno; un valor mayor que el real deja esquivar el límite de intentos.
TRUST_PROXY_HOPS=1
