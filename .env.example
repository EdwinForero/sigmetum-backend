NODE_ENV=local
PORT=8000

# AWS — config (cambia por entorno)
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=sigmetum-dev

# AWS — credenciales
# En local: autenticación vía SSO profile (no usar ACCESS_KEY ni SECRET)
AWS_PROFILE=my-sso-profile
# En preprod/prod: dejar AWS_PROFILE vacío — el SDK usa el IAM role del servidor automáticamente

# Auth
# Reglas de valor (config/validateEnv.js): estrictas salvo NODE_ENV=local o NODE_ENV=test, donde solo avisan.
# JWT_SECRET: al menos 32 caracteres, aleatorio y distinto por entorno (HS256).
JWT_SECRET=
# JWT_EXPIRATION: duración con unidad y mayor que cero (8h, 10m, 1d); no vale 3600 sin unidad, ni 0 ni negativos.
JWT_EXPIRATION=8h
ADMIN_USERNAME=
# ADMIN_PASSWORD: hash bcrypt completo ($2a$, $2b$ o $2y$), nunca la contraseña en claro.
ADMIN_PASSWORD=

# Email
EMAIL=
EMAIL_PASSWORD=

# CORS — URL del frontend (cambia por entorno)
ALLOWED_ORIGIN=http://localhost:3000

# API prefix
API_PREFIX=/api/v1
